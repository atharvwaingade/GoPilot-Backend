{
  "manifest_version": 3,
  "name": "GoPilot",
  "version": "2.0.0",
  "description": "GoPilot — real-time ERP co-pilot with continuous DOM perception, voice, and autonomous form filling.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "http://localhost:8000/*",
    "ws://localhost:8000/*",
    "http://*/*",
    "https://*/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "GoPilot"
  },

  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "content/extractor.js",
        "content/executor.js",
        "content/vision_observer.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "icons": {
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}